# EBHC — ebhctournament.ca
RewriteEngine On

# HTTPS and www->non-www are enforced by Hostinger's edge; no rewrite here.

# Memorable short links
Redirect 301 /results /2026/
Redirect 301 /stats https://tournaments.shinnyofchampions.com/stats#/3724/leaders/table?game_type=Round%20Robin&page=1&player_type=players&division_id=47353
Redirect 301 /standings https://tournaments.shinnyofchampions.com/stats#/3724/standings?division_id=47353&render=division
Redirect 301 /replays https://www.youtube.com/@ebhctournament
Redirect 301 /youtube https://www.youtube.com/@ebhctournament
Redirect 301 /instagram https://www.instagram.com/ebhctournament/
Redirect 301 /facebook https://www.facebook.com/ebhctournament
Redirect 301 /register /#registration

# Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
